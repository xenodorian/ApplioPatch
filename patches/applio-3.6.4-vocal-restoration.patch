+def _smooth_f0(f0, window):
+    """Median-filter the pitch contour inside each voiced run.
+
+    Unvoiced frames (f0 == 0) are never touched and never enter a median, so
+    voiced runs keep their exact length and their edges are not pulled toward
+    zero. The window is in frames, forced odd, and shrinks to fit short runs.
+    """
+    from scipy.ndimage import median_filter
+
+    size = int(window) | 1
+    out = f0.copy()
+    voiced = f0 > 0
+    edges = np.flatnonzero(np.diff(np.concatenate(([0], voiced.view(np.int8), [0]))))
+    for start, end in zip(edges[::2], edges[1::2]):
+        run = end - start
+        if run < 3:
+            continue
+        width = min(size, run if run % 2 else run - 1)
+        out[start:end] = median_filter(f0[start:end], size=width, mode="nearest")
+    return out
+

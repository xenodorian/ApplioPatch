--- /dev/null
+++ b/rvc/lib/tools/audio_restore.py
@@ -0,0 +1,691 @@
+"""Optional vocal restoration before conversion (VoiceFixer, Resemble Enhance).
+
+Both restorers depend on packages that conflict with Applio's pinned stack
+(different numpy/torch/deepspeed requirements), so each one runs in its own
+sidecar virtual environment under <Applio>/assets/audio-restore. The sidecar
+is created on first use from exact version pins and reused afterwards.
+Restoration runs only on the local machine; no audio is uploaded.
+
+Model weights are fetched by the packages themselves on first run:
+VoiceFixer from Zenodo, Resemble Enhance from Hugging Face.
+"""
+
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import threading
+import shutil
+from collections import deque
+from pathlib import Path
+
+import numpy as np
+import soundfile as sf
+import soxr
+
+SIDECAR_VERSION = "2"
+WORKER = Path(__file__).with_name("audio_restore_worker.py")
+APPLIO_ROOT = Path(__file__).resolve().parents[3]
+TIMEOUT_SECONDS = 60 * 60
+INSTALL_TIMEOUT_SECONDS = 2 * 60 * 60
+UV_VERSION = "0.9.5"
+
+# Exact pins taken from a working resolve on Python 3.11. NumPy stays below
+# 2.4 because Resemble Enhance converts one-element arrays with float(), which
+# NumPy 2.4 rejects. Transitive dependencies are frozen to a date with uv's
+# --exclude-newer so a fresh install months later resolves to the same
+# versions.
+RESOLVE_DATE = "2026-11-01"
+CACHE_LIMIT = 24
+
+SPECS = {
+    "voicefixer": {
+        "python": "3.11",
+        "packages": [
+            "voicefixer==0.1.3",
+            "torch==2.15.0",
+            "numpy==2.3.5",
+            "scipy==1.17.1",
+            "librosa==0.11.0",
+            "soundfile==0.14.0",
+        ],
+        "nodeps": [],
+    },
+    "resemble-enhance": {
+        "python": "3.11",
+        # The package declares deepspeed, gradio and other training or demo
+        # dependencies that inference never uses. It is installed with
+        # --no-deps and only the runtime packages are listed here; the worker
+        # supplies a stand-in for the unused deepspeed import.
+        "packages": [
+            "torch==2.15.0",
+            "torchaudio==2.11.1",
+            "numpy==2.3.5",
+            "librosa==0.11.0",
+            "soundfile==0.14.0",
+            "omegaconf==2.4.0",
+            "scipy",
+            "tqdm",
+            "rich",
+            "resampy",
+            "pandas",
+            "tabulate",
+            "matplotlib",
+        ],
+        # Each entry lists alternative sources for one package, tried in order.
+        # The zip needs no git; the git source is the fallback.
+        "nodeps": [
+            [
+                "resemble-enhance @ https://github.com/resemble-ai/resemble-enhance/archive/8e978149bfe8abab3eb77d965d579a111afdb0ff.zip",
+                "resemble-enhance @ git+https://github.com/resemble-ai/resemble-enhance.git@8e978149bfe8abab3eb77d965d579a111afdb0ff",
+            ],
+        ],
+    },
+}
+
+MODES = ("off", "voicefixer", "resemble-enhance")
+
+
+MAX_ROOT_LENGTH = 70
+MIN_FREE_GB = 10
+
+
+def _root():
+    """Where sidecar environments live.
+
+    Normally inside the Applio folder. Windows limits paths to 260
+    characters and PyTorch has very long internal file names, so a deeply
+    nested Applio folder falls back to a short folder at the drive root.
+    """
+    default = APPLIO_ROOT / "assets" / "audio-restore"
+    if os.name == "nt" and len(str(default)) > MAX_ROOT_LENGTH:
+        return Path(APPLIO_ROOT.anchor) / "applio-ar"
+    return default
+
+
+def sidecar_ready(backend):
+    """True when the restorer's environment is already installed."""
+    env = _env_dir(backend)
+    marker = env / "applio-spec.json"
+    try:
+        return (
+            _venv_python(env).exists()
+            and marker.exists()
+            and marker.read_text() == json.dumps(SPECS[backend], sort_keys=True)
+        )
+    except OSError:
+        return False
+
+
+def _env_dir(backend):
+    return _root() / f"{backend}-v{SIDECAR_VERSION}"
+
+
+def _venv_python(env):
+    if os.name == "nt":
+        return env / "Scripts" / "python.exe"
+    return env / "bin" / "python"
+
+
+FAILURE_HINTS = (
+    (("out of memory",), "Out of memory. Try a shorter file or close other programs."),
+    (
+        ("no space left", "not enough space", "os error 112", "errno 28"),
+        "The drive is out of space. Free at least 10 GB and try again.",
+    ),
+    (
+        ("filename too long", "winerror 206", "os error 206", "path too long"),
+        "A file path is too long for Windows. Move the Applio folder to a shorter path such as D:\\Applio, or enable Windows long paths.",
+    ),
+    (
+        ("access is denied", "permission denied"),
+        "Access was denied. Antivirus software or Windows Controlled folder access may be blocking the Applio folder.",
+    ),
+    (
+        ("git executable not found", "cannot find git", "'git'"),
+        "Git is not installed. Install Git for Windows from git-scm.com and try again.",
+    ),
+    (
+        (
+            "failed to fetch",
+            "tunnel error",
+            "connection",
+            "timed out",
+            "timeout",
+            "name or service not known",
+            "getaddrinfo",
+            "ssl error",
+            "certificate",
+            "forbidden",
+        ),
+        "A download failed. Check your internet connection and that a firewall, VPN or antivirus is not blocking github.com, pypi.org, huggingface.co or zenodo.org.",
+    ),
+)
+
+
+def explain_failure(text):
+    """Plain-language hint for a failed install or restoration, or ''."""
+    lowered = text.lower()
+    for needles, hint in FAILURE_HINTS:
+        if any(needle in lowered for needle in needles):
+            return hint
+    return ""
+
+
+def _run(command, env=None, timeout=TIMEOUT_SECONDS, label="Audio restoration"):
+    """Run a command, echo its output to the console, keep the tail for errors."""
+    process = subprocess.Popen(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        errors="replace",
+        env=env,
+    )
+    timer = threading.Timer(timeout, process.kill)
+    timer.start()
+    tail = deque(maxlen=15)
+    try:
+        for line in process.stdout:
+            line = line.rstrip()
+            if line:
+                tail.append(line)
+                print(f"[{label}] {line}", flush=True)
+        process.wait()
+    finally:
+        timer.cancel()
+    if process.returncode != 0:
+        hint = explain_failure("\n".join(tail))
+        raise RuntimeError(
+            f"{label} failed. {hint}\n" + "\n".join(tail)
+            if hint
+            else f"{label} failed:\n" + "\n".join(tail)
+        )
+
+
+def _uv():
+    """Find uv, or install it once into a small private environment."""
+    found = shutil.which("uv")
+    if found:
+        return found
+    tool_env = _root() / "uv-tool"
+    python = _venv_python(tool_env)
+    uv = python.parent / ("uv.exe" if os.name == "nt" else "uv")
+    if uv.exists():
+        return str(uv)
+    _root().mkdir(parents=True, exist_ok=True)
+    print("Preparing the installer tool (first use only)...", flush=True)
+    if tool_env.exists():
+        shutil.rmtree(tool_env)
+    _run([sys.executable, "-m", "venv", str(tool_env)], label="Setup")
+    _run(
+        [str(python), "-m", "pip", "install", "--no-input", f"uv=={UV_VERSION}"],
+        timeout=INSTALL_TIMEOUT_SECONDS,
+        label="Setup",
+    )
+    if not uv.exists():
+        raise RuntimeError(f"uv was installed but not found at {uv}")
+    return str(uv)
+
+
+def ensure_sidecar(backend):
+    """Create or reuse the isolated environment for one restorer."""
+    spec = SPECS[backend]
+    env = _env_dir(backend)
+    python = _venv_python(env)
+    marker = env / "applio-spec.json"
+    wanted = json.dumps(spec, sort_keys=True)
+    if python.exists() and marker.exists() and marker.read_text() == wanted:
+        return python
+
+    _preflight(backend)
+    uv = _uv()
+    label = f"Setup {backend}"
+    print(
+        f"Preparing the {backend} environment (first use only, large download)...",
+        flush=True,
+    )
+    env.parent.mkdir(parents=True, exist_ok=True)
+    if env.exists():
+        shutil.rmtree(env)
+    _run(
+        [uv, "venv", "--python", spec["python"], str(env)],
+        timeout=INSTALL_TIMEOUT_SECONDS,
+        label=label,
+    )
+    base = [uv, "pip", "install", "--python", str(python)]
+    # Try the CUDA wheels that match Applio's own PyTorch first, then uv's
+    # automatic choice, then the default wheels (CPU only on Windows). The
+    # first one that installs wins.
+    install = ["--exclude-newer", RESOLVE_DATE, *spec["packages"]]
+    attempts = []
+    applio_backend = _applio_torch_backend()
+    if applio_backend:
+        attempts.append(["--torch-backend", applio_backend])
+    attempts += [["--torch-backend", "auto"], []]
+    for index, extra in enumerate(attempts):
+        try:
+            _run(
+                base + extra + install,
+                timeout=INSTALL_TIMEOUT_SECONDS,
+                label=label,
+            )
+            break
+        except RuntimeError as error:
+            if index == len(attempts) - 1:
+                raise
+            print(f"Install attempt failed, trying the next option:\n{error}", flush=True)
+    for alternatives in spec["nodeps"]:
+        for index, source in enumerate(alternatives):
+            try:
+                _run(
+                    base + ["--no-deps", source],
+                    timeout=INSTALL_TIMEOUT_SECONDS,
+                    label=label,
+                )
+                break
+            except RuntimeError as error:
+                if index == len(alternatives) - 1:
+                    raise
+                print(f"Source failed, trying the next one:\n{error}", flush=True)
+    marker.write_text(wanted)
+    _remove_old_sidecars(backend, env)
+    _report_gpu(python)
+    return python
+
+
+def _preflight(backend):
+    """Fail early, in plain words, when an install cannot succeed."""
+    root = _root()
+    root.mkdir(parents=True, exist_ok=True)
+    free_gb = shutil.disk_usage(root).free / 1024**3
+    if free_gb < MIN_FREE_GB:
+        raise RuntimeError(
+            f"Not enough free disk space for the {backend} environment: "
+            f"{free_gb:.1f} GB free on {root.anchor or root}, at least {MIN_FREE_GB} GB needed."
+        )
+    import socket
+
+    hosts = ["pypi.org", "files.pythonhosted.org", "github.com"]
+    hosts.append("huggingface.co" if backend == "resemble-enhance" else "zenodo.org")
+    blocked = []
+    for host in hosts:
+        try:
+            socket.create_connection((host, 443), timeout=10).close()
+        except OSError:
+            blocked.append(host)
+    if blocked:
+        # A proxy can make this check fail while installs still work, so
+        # warn and carry on; a real failure is explained afterwards.
+        print(
+            "Warning: could not reach " + ", ".join(blocked) + ". "
+            "If the install fails, check your internet connection, firewall or VPN.",
+            flush=True,
+        )
+
+
+def _applio_torch_backend():
+    """The uv torch backend matching Applio's own CUDA build, or None."""
+    try:
+        import torch
+
+        version = torch.version.cuda
+        return "cu" + version.replace(".", "") if version else None
+    except Exception:
+        return None
+
+
+def _remove_old_sidecars(backend, current):
+    """Delete environments from older sidecar versions to free disk space."""
+    for old in _root().glob(f"{backend}-v*"):
+        if old != current and old.is_dir():
+            shutil.rmtree(old, ignore_errors=True)
+
+
+def _report_gpu(python):
+    """Say whether the new environment can use the GPU."""
+    try:
+        result = subprocess.run(
+            [str(python), "-I", "-c", "import torch;print(torch.cuda.is_available())"],
+            capture_output=True,
+            text=True,
+            timeout=300,
+        )
+        usable = result.stdout.strip() == "True"
+    except Exception:
+        usable = False
+    print(
+        "Restoration environment can use the GPU."
+        if usable
+        else "Restoration environment is CPU only, so restoration will be slow.",
+        flush=True,
+    )
+
+
+def _device():
+    try:
+        import torch
+
+        return "cuda" if torch.cuda.is_available() else "cpu"
+    except Exception:
+        return "cpu"
+
+
+def _cache_key(data, sample_rate, mode, options):
+    digest = hashlib.sha256()
+    digest.update(np.ascontiguousarray(data).tobytes())
+    digest.update(
+        json.dumps(
+            [int(sample_rate), mode, SIDECAR_VERSION, SPECS[mode], options],
+            sort_keys=True,
+            default=str,
+        ).encode()
+    )
+    return digest.hexdigest()
+
+
+def _cache_get(path, length):
+    try:
+        cached = np.load(path)
+    except (OSError, ValueError):
+        return None
+    return cached if cached.ndim == 1 and len(cached) == length else None
+
+
+def _cache_put(folder, path, restored):
+    folder.mkdir(parents=True, exist_ok=True)
+    # Write then rename so an interrupted job never leaves a truncated entry.
+    temporary = path.with_suffix(".tmp.npy")
+    np.save(temporary, restored)
+    temporary.replace(path)
+    entries = sorted(folder.glob("*.npy"), key=lambda entry: entry.stat().st_mtime)
+    for stale in entries[:-CACHE_LIMIT]:
+        stale.unlink(missing_ok=True)
+
+
+def blend_restored(original, restored, blend):
+    """Mix restored audio with the original.
+
+    The restored signal is first matched to the original's RMS so the mix
+    changes the character of the voice, not its loudness. Blend 1.0 returns
+    the restored audio untouched and 0.0 returns the original.
+    """
+    blend = float(min(max(blend, 0.0), 1.0))
+    if blend >= 1.0:
+        return restored
+    if blend <= 0.0:
+        return original
+    rms_original = float(np.sqrt(np.mean(np.square(original, dtype=np.float64))))
+    rms_restored = float(np.sqrt(np.mean(np.square(restored, dtype=np.float64))))
+    gain = rms_original / rms_restored if rms_restored > 1e-8 else 1.0
+    mixed = blend * restored * gain + (1.0 - blend) * original
+    return mixed.astype(np.float32)
+
+
+# --- Guard -------------------------------------------------------------
+# Both restorers are trained on speech. On singing they can erase quiet
+# passages (breaths, note tails) and move the pitch. The guard compares the
+# restored audio with the original, at the 16 kHz that voice conversion
+# actually uses, and falls back to the original wherever the restorer
+# removed too much level or shifted the pitch. Everywhere else the restored
+# audio is kept. Switches are short crossfades.
+
+GUARD_DEFAULTS = {"max_drop_db": 4.0, "max_cents": 50.0}
+GUARD_RATE = 16000
+GUARD_HOP = 160  # 10 ms at 16 kHz
+
+
+def _envelope(x, rate, block_ms=0.25):
+    """Rectified, block-averaged signal with its slow trend removed."""
+    block = max(1, int(rate * block_ms / 1000))
+    n = len(x) // block * block
+    env = np.abs(x[:n]).reshape(-1, block).mean(axis=1)
+    from scipy.ndimage import uniform_filter1d
+
+    return env - uniform_filter1d(env, 200), block
+
+
+def estimate_lag(original, restored, rate, max_ms=20.0, segments=5, seconds=6):
+    """Time offset of `restored` against `original`, in samples, or 0.
+
+    A generative restorer rebuilds the waveform, so sample-level correlation
+    is unreliable. The loudness envelope survives, so the offset is read from
+    that, on several of the loudest segments. If the segments disagree the
+    audio is left unshifted rather than shifted by a bad guess.
+    """
+    from scipy.signal import correlate
+
+    n = min(len(original), len(restored))
+    span = int(seconds * rate)
+    if n < span * 2:
+        return 0
+    hops = np.arange(0, n - span, span)
+    energy = np.array([np.abs(original[h : h + span]).mean() for h in hops])
+    picks = hops[np.argsort(energy)[::-1][:segments]]
+    lags = []
+    for start in picks:
+        eo, block = _envelope(original[start : start + span], rate)
+        er, _ = _envelope(restored[start : start + span], rate)
+        m = min(len(eo), len(er))
+        limit = int(max_ms / 1000 * rate / block)
+        c = correlate(er[:m], eo[:m], mode="full", method="fft")
+        mid = m - 1
+        window = c[mid - limit : mid + limit + 1]
+        lags.append((int(np.argmax(window)) - limit) * block)
+    lags = np.array(lags)
+    spread = lags.max() - lags.min()
+    if spread > rate * 0.002:  # segments disagree by more than 2 ms
+        return 0
+    return int(np.median(lags))
+
+
+def _shift(x, lag):
+    """Move `x` earlier by `lag` samples (a delayed signal has lag > 0)."""
+    if lag == 0:
+        return x
+    out = np.zeros_like(x)
+    if lag > 0:
+        out[:-lag] = x[lag:]
+    else:
+        out[-lag:] = x[:lag]
+    return out
+
+
+def _levels_db(x16):
+    import librosa
+
+    rms = librosa.feature.rms(y=x16, frame_length=640, hop_length=GUARD_HOP)[0]
+    return 20 * np.log10(rms + 1e-7)
+
+
+def _pitch(x16):
+    import librosa
+
+    return librosa.yin(
+        x16, fmin=70, fmax=1100, sr=GUARD_RATE, frame_length=1024, hop_length=GUARD_HOP
+    )
+
+
+def guard_weights(original, restored, rate, max_drop_db=4.0, max_cents=50.0):
+    """Per-sample weight of the ORIGINAL (0 = keep restored, 1 = keep original).
+
+    Returns (weights, report). `restored` must already be aligned.
+    """
+    from scipy.ndimage import median_filter, uniform_filter1d, maximum_filter1d
+
+    o16 = soxr.resample(original, rate, GUARD_RATE)
+    r16 = soxr.resample(restored, rate, GUARD_RATE)
+    lo, lr = _levels_db(o16), _levels_db(r16)
+    n = min(len(lo), len(lr))
+    lo, lr = lo[:n], lr[:n]
+
+    audible = lo > -80.0  # digital silence is not "lost content"
+    drop = lo - lr
+    w_level = np.clip((drop - max_drop_db) / 6.0, 0.0, 1.0) * audible
+
+    fo, fr = _pitch(o16)[:n], _pitch(r16)[:n]
+    n = min(n, len(fo), len(fr))
+    cents = np.abs(1200 * np.log2(fr[:n] / fo[:n]))
+    loud = lo[:n] > np.percentile(lo[audible[:n]] if audible[:n].any() else lo[:n], 40)
+    w_pitch = ((cents > max_cents) & loud).astype(np.float64)
+    w_pitch = median_filter(w_pitch, size=5)
+
+    w = np.maximum(w_level[:n], w_pitch)
+    w = maximum_filter1d(w, size=5)  # widen by ~20 ms each side
+    w = uniform_filter1d(w, size=5)
+    frames = np.arange(n) * GUARD_HOP * rate / GUARD_RATE
+    per_sample = np.interp(np.arange(len(original)), frames, w)
+    per_sample = uniform_filter1d(per_sample, int(0.02 * rate))
+    report = {
+        "fraction_original": float(per_sample.mean()),
+        "frames_level": float((w_level[:n] > 0).mean()),
+        "frames_pitch": float(w_pitch.mean()),
+    }
+    return np.clip(per_sample, 0.0, 1.0), report
+
+
+def guard_restored(original, restored, rate, **options):
+    """Return `restored` with the original put back where the restorer broke it."""
+    params = {**GUARD_DEFAULTS, **{k: v for k, v in options.items() if k in GUARD_DEFAULTS}}
+    lag = estimate_lag(original, restored, rate)
+    aligned = _shift(restored, lag)
+    weights, report = guard_weights(original, aligned, rate, **params)
+    mixed = weights * original + (1.0 - weights) * aligned
+    print(
+        f"Audio restoration guard: kept original for {report['fraction_original']:.0%} "
+        f"of the audio (level {report['frames_level']:.0%}, pitch {report['frames_pitch']:.0%}), "
+        f"offset {lag} samples",
+        flush=True,
+    )
+    return mixed.astype(np.float32)
+
+
+def restore_audio(audio, sample_rate, mode="off", **options):
+    """Return restored mono float32 audio at the original rate and length.
+
+    Off is an exact bypass. The sidecar receives a 32-bit float WAV and
+    returns one; the result is resampled back to the input rate, trimmed or
+    padded to the input length, and mixed with the original by `blend`.
+    """
+    if mode not in MODES:
+        raise ValueError(f"Unknown restoration mode: {mode}")
+    if mode == "off":
+        return audio
+
+    data = np.asarray(audio, dtype=np.float32)
+    if data.ndim > 1:
+        data = data.mean(axis=1)
+    if not np.isfinite(data).all():
+        raise ValueError("Restoration input contains non-finite samples")
+    if not data.size or not data.any():
+        return data
+
+    tuning = {
+        key: options.get(key)
+        for key in ("nfe", "solver", "lambd", "tau")
+        if mode == "resemble-enhance"
+    }
+    cache_folder = _root() / "cache"
+    cache_path = cache_folder / f"{_cache_key(data, sample_rate, mode, tuning)}.npy"
+    restored = _cache_get(cache_path, len(data))
+    if restored is not None:
+        print(f"Audio restoration: {mode} (cached)", flush=True)
+        os.utime(cache_path)
+    else:
+        restored = _restore_with_sidecar(data, sample_rate, mode, options)
+        _cache_put(cache_folder, cache_path, restored)
+
+    # The guard and the blend are applied after the cache, so changing them
+    # is instant. The guard can be turned off with guard=False or by setting
+    # the environment variable APPLIO_RESTORE_GUARD=0.
+    if options.get("guard", True) and os.environ.get("APPLIO_RESTORE_GUARD", "1") != "0":
+        restored = guard_restored(data, restored, int(sample_rate), **options)
+    return blend_restored(data, restored, options.get("blend", 1.0))
+
+
+def _restore_with_sidecar(data, sample_rate, mode, options):
+    python = ensure_sidecar(mode)
+    device = options.get("device") or _device()
+    try:
+        return _run_sidecar(python, data, sample_rate, mode, options, device)
+    except RuntimeError as error:
+        # A GPU that runs out of memory on a long file can still do the job
+        # on the CPU, only slower.
+        if device == "cuda" and "out of memory" in str(error).lower():
+            print("GPU ran out of memory, retrying on the CPU...", flush=True)
+            return _run_sidecar(python, data, sample_rate, mode, options, "cpu")
+        raise
+
+
+def _run_sidecar(python, data, sample_rate, mode, options, device):
+    print(f"Audio restoration: {mode} on {device}", flush=True)
+
+    with tempfile.TemporaryDirectory(prefix="applio-restore-") as directory:
+        source = Path(directory) / "input.wav"
+        target = Path(directory) / "output.wav"
+        sf.write(source, data, int(sample_rate), subtype="FLOAT")
+
+        command = [
+            str(python),
+            "-I",
+            str(WORKER),
+            "--backend",
+            mode,
+            "--input",
+            str(source),
+            "--output",
+            str(target),
+            "--device",
+            device,
+        ]
+        if mode == "resemble-enhance":
+            command += [
+                "--nfe",
+                str(int(options.get("nfe", 32))),
+                "--solver",
+                str(options.get("solver", "midpoint")),
+                "--lambd",
+                str(float(options.get("lambd", 0.1))),
+                "--tau",
+                str(float(options.get("tau", 0.5))),
+            ]
+        env = dict(os.environ)
+        # VoiceFixer caches under ~/.cache; keep it inside the sidecar root.
+        home = _env_dir(mode) / "home"
+        home.mkdir(parents=True, exist_ok=True)
+        env["HOME"] = env["USERPROFILE"] = str(home)
+        _run(command, env=env, label=f"Restore {mode}")
+
+        restored, out_rate = sf.read(target, dtype="float32", always_2d=False)
+        if restored.ndim > 1:
+            restored = restored.mean(axis=1)
+        if out_rate != sample_rate:
+            restored = soxr.resample(restored, out_rate, int(sample_rate))
+
+    length = len(data)
+    if len(restored) >= length:
+        restored = restored[:length]
+    else:
+        restored = np.pad(restored, (0, length - len(restored)))
+    return restored.astype(np.float32)
+
+
+def restore_file(input_path, mode, **options):
+    """Restore one audio file and return the path of the restored WAV.
+
+    Used by the GUI preview button so the result can be auditioned before a
+    voice conversion is run.
+    """
+    path = str(input_path).strip().strip('"')
+    if not os.path.isfile(path):
+        raise FileNotFoundError(f"File not found: {path}")
+    audio, rate = sf.read(path, dtype="float32", always_2d=True)
+    mono = audio.mean(axis=1)
+    restored = restore_audio(mono, rate, mode, **options)
+    folder = Path(tempfile.gettempdir()) / "applio-restore-preview"
+    folder.mkdir(parents=True, exist_ok=True)
+    out = folder / f"{Path(path).stem}_restored_{mode}.wav"
+    sf.write(out, restored, int(rate), subtype="PCM_24")
+    return str(out)
